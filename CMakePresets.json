{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "win-msvc",
      "displayName": "Windows / MSVC (Visual Studio 18 2026)",
      "description": "The only supported target right now.",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64"
    },
    {
      "name": "win-null",
      "displayName": "Windows / portable gate (FAMULUS_OS=null)",
      "description": "Builds src/core/ with no platform adapter. This is the check CI must keep green.",
      "inherits": "win-msvc",
      "cacheVariables": {
        "FAMULUS_OS": "null",
        "FAMULUS_BUILD_SHELL": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-debug",
      "configurePreset": "win-msvc",
      "configuration": "Debug"
    },
    {
      "name": "win-release",
      "configurePreset": "win-msvc",
      "configuration": "Release"
    },
    {
      "name": "win-null-debug",
      "configurePreset": "win-null",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "win-debug",
      "configurePreset": "win-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
