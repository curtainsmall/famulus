{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "win-msvc",
      "displayName": "Windows / MSVC (Visual Studio 18 2026)",
      "description": "Default dev preset. No third-party dependencies needed yet.",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "win-null",
      "displayName": "Windows / portable gate (FAMULUS_OS=null)",
      "description": "Builds core/ with no platform adapter. This is the check CI must keep green.",
      "inherits": "win-msvc",
      "cacheVariables": {
        "FAMULUS_OS": "null",
        "FAMULUS_BUILD_SHELL": "OFF"
      }
    },
    {
      "name": "linux-ninja",
      "displayName": "Linux / Ninja",
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-server",
      "displayName": "Linux server / no adapter, no shell",
      "description": "What the cloud side of a mobile client runs.",
      "inherits": "linux-ninja",
      "cacheVariables": {
        "FAMULUS_OS": "null",
        "FAMULUS_BUILD_SHELL": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "mac-ninja",
      "displayName": "macOS / Ninja",
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-debug",
      "configurePreset": "win-msvc",
      "configuration": "Debug"
    },
    {
      "name": "win-release",
      "configurePreset": "win-msvc",
      "configuration": "Release"
    },
    {
      "name": "win-null-debug",
      "configurePreset": "win-null",
      "configuration": "Debug"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-ninja"
    },
    {
      "name": "mac-debug",
      "configurePreset": "mac-ninja"
    }
  ],
  "testPresets": [
    {
      "name": "win-debug",
      "configurePreset": "win-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-ninja",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
